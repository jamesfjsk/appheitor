rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function familyHeitor() {
      return request.resource.data.familyId == 'heitor';
    }

    // ---------- USERS ----------
    match /users/{uid} {
      // Admin pode ler todo mundo; usuário lê o próprio doc
      allow read: if signedIn() && (isAdmin() || uid == request.auth.uid);

      // Admin pode criar/atualizar qq usuário;
      // usuário pode atualizar o próprio perfil básico
      allow write: if signedIn() && (isAdmin() || uid == request.auth.uid);
    }

    // ---------- PROGRESS ----------
    match /progress/{uid} {
      // Admin e o próprio usuário leem
      allow read: if signedIn() && (isAdmin() || uid == request.auth.uid);

      // Admin pode atualizar o progresso de qq filho;
      // o próprio usuário pode atualizar o seu (marcar tarefas como feitas, etc)
      allow write: if signedIn() && (isAdmin() || uid == request.auth.uid);
    }

    // ---------- TASKS ----------
    match /tasks/{taskId} {
      // Admin lê tudo; filho só lê as suas
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);

      // Criança cria só missão própria (origin child, proposed, gold 0). Admin cria/exclui tudo.
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.gold == 0
        && request.resource.data.xp is int
        && request.resource.data.xp <= 10
        && (
          (request.resource.data.origin == 'child' && request.resource.data.status == 'proposed')
          || (
            request.resource.data.origin == 'agenda'
            && request.resource.data.optional == true
            && request.resource.data.gold == 0
            && request.resource.data.date is string
          )
        )
      );
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status != 'proposed'
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastCompletedDate', 'updatedAt'])
          || (
            resource.data.origin == 'agenda'
            && resource.data.optional == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
            && request.resource.data.active == false
          )
        )
      );

      // ---------- TASK COMPLETIONS (subcoleção) ----------
      match /completions/{dateId} {
        // Admin lê tudo; filho lê só as suas completions
        // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
        allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
        allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

        // Filho pode criar completion em seu próprio nome; admin também pode
        allow create: if signedIn() && (
          isAdmin() || request.resource.data.userId == request.auth.uid
        ) && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0
          && request.resource.data.createdAt is timestamp;

        // Update/delete só admin
        allow update, delete: if isAdmin();
      }
    }

    // ---------- REWARDS ----------
    match /rewards/{rewardId} {
      // Admin lê tudo; filho lê só as suas
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);

      // Admin cria/edita/exclui recompensas (para um ownerId=uid do filho)
      // Regras mínimas de integridade: ownerId (string), createdAt (timestamp)
      allow create, update, delete: if isAdmin()
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId.size() > 0
        && request.resource.data.createdAt is timestamp;
    }

    // ---------- REDEMPTIONS (resgates) ----------
    match /redemptions/{docId} {
      // Admin lê tudo; filho lê só os seus resgates
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      // Filho pode criar resgate em seu próprio nome; admin também pode
      allow create: if signedIn() && (
        isAdmin() || request.resource.data.userId == request.auth.uid
      );

      // Update/delete só admin
      allow update, delete: if isAdmin();
    }

    // ---------- NOTIFICATIONS (opcional) ----------
    match /notifications/{id} {
      // Admin lê tudo; filho lê o que é endereçado a ele
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.toUserId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.toUserId == request.auth.uid);

      // Somente admin cria/edita/exclui notificações
      allow create, update, delete: if isAdmin();
    }

    // Surprise Mission Config
    match /surpriseMissionConfig/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Daily Surprise Mission Status
    match /dailySurpriseMissionStatus/{statusId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Daily Quizzes
    match /dailyQuizzes/{quizId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      // A prova é gerada e respondida pela própria criança ou pelo responsável
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Daily Progress
    match /dailyProgress/{progressId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Birthday Events
    match /birthdayEvents/{eventId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Birthday Config
    match /birthdayConfig/{configId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Flash Reminders
    match /flashReminders/{reminderId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Achievements
    match /achievements/{achievementId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.ownerId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // User Achievements
    match /userAchievements/{userAchievementId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Task Completions (global collection)
    match /taskCompletions/{completionId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.reverted == true
        && request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Progress Snapshots (audit trail)
    match /progressSnapshots/{snapshotId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId is string;
      allow update, delete: if isAdmin();
    }

    // Notes (admin only)
    match /notes/{noteId} {
      allow read: if signedIn() && isAdmin() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && isAdmin() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && isAdmin() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- GOLD TRANSACTIONS (livro-razão do gold) ----------
    match /goldTransactions/{transactionId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---------- AJUSTES MANUAIS DE XP (só responsável) ----------
    match /xpAdjustments/{adjustmentId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------- ARENA DE INGLÊS ----------
    match /englishSessions/{sessionId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /englishProgress/{uid} {
      allow read: if signedIn() && (isAdmin() || uid == request.auth.uid);
      allow write: if signedIn() && (isAdmin() || uid == request.auth.uid);
    }

    // ---------- A BASE (Arena de Inglês, Etapa 1) ----------
    // Plano do dia: englishPlans/{uid_date}; gerado pela própria criança ou pelo responsável
    match /englishPlans/{planId} {
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    // Base da criança: englishBase/{uid}
    match /englishBase/{baseId} {
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    // Índice do cache de TTS (englishAudio/{hash}) e contadores de uso de IA por mês (aiUsage/{yyyy-mm}):
    // compartilhados pela família, sem dono
    match /englishAudio/{hash} {
      allow read, write: if signedIn();
    }
    match /aiUsage/{month} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- SETTINGS (modo férias, regras do dia) ----------
    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- VILA (Etapa 1) ----------
    match /village/{uid} {
      allow read: if signedIn() && (isAdmin() || uid == request.auth.uid);
      allow create: if signedIn() && (isAdmin() || uid == request.auth.uid);
      allow delete: if isAdmin();
      allow update: if signedIn() && (
        isAdmin()
        || (
          uid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['season', 'stars', 'launchedOn', 'launchedAt', 'userId', 'createdAt'])
        )
      );
    }

    // ---------- ESTANTE DO SÁBIO (decisão 40): livros e relatos de leitura ----------
    match /books/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && familyHeitor() && (
        isAdmin()
        || (
          request.resource.data.userId == request.auth.uid
          && request.resource.data.addedBy == 'child'
          && request.resource.data.status == 'to_read'
          && !request.resource.data.keys().hasAny(['gold'])
        )
      );
      // a criança só marca o livro como lido pela transação de pagamento
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'doneOn', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /bookReports/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && familyHeitor() && (
        isAdmin()
        || (
          request.resource.data.userId == request.auth.uid
          && request.resource.data.paidGold == 0
          && request.resource.data.paidXp == 0
          && !request.resource.data.keys().hasAny(['parentDecision'])
        )
      );
      // a criança só recebe o pagamento pela transação; parentDecision é do pai
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidGold', 'paidXp', 'accepted', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /quizBank/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && (isAdmin() || request.resource.data.userId == request.auth.uid)
        && request.resource.data.keys().hasAll(['userId', 'date', 'question', 'hash', 'correct', 'category']);
      allow update: if signedIn() && (isAdmin() || (resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewedOk', 'reviewedOn'])));
      allow delete: if isAdmin();
    }

    match /notices/{noticeId} {
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackAt'])
      );
    }

    match /habits/{habitId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /clientErrors/{errorId} {
      allow create: if signedIn();
      allow read, delete: if isAdmin();
    }

    match /health/{uid} {
      allow read, write: if signedIn() && (isAdmin() || uid == request.auth.uid);
    }

    match /goals/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && familyHeitor() && (
        isAdmin()
        || (
          request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.savedGold == 0
        )
      );
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid && (
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['savedGold', 'lastInterestWeek', 'interestPaid', 'status', 'cancelReason', 'updatedAt', 'unlockOn', 'lockWeeks'])
          && request.resource.data.savedGold >= resource.data.savedGold
          && (request.resource.data.status == resource.data.status || request.resource.data.status == 'cancel_requested')
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unlockOn'])
            || !resource.data.keys().hasAny(['unlockOn'])
            || (
              request.resource.data.unlockOn is string
              && request.resource.data.unlockOn >= resource.data.unlockOn
            )
          )
        )
        || (
          resource.data.savedGold == 0
          && request.resource.data.savedGold == 0
          && request.resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'targetGold', 'rewardId', 'updatedAt'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt'])
          && resource.data.status in ['open', 'cancel_requested']
          && request.resource.data.status == 'cancelled'
        )
      ));
      allow delete: if isAdmin();
    }

    match /challenges/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create: if familyHeitor() && (isAdmin() || (
        signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'proposed'
        && request.resource.data.goldReward is int
        && request.resource.data.goldReward <= 20
        && request.resource.data.xpReward is int
        && request.resource.data.xpReward <= 20
        && request.resource.data.target is int
        && request.resource.data.target >= 5
      ));
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress', 'completedAt', 'extendedDays', 'endsOn', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /learning/{uid} {
      allow read, write: if signedIn() && (isAdmin() || uid == request.auth.uid);
    }

    match /agenda/{id} {
      allow get, list: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow create: if familyHeitor() && (isAdmin() || (
        signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdBy == 'child'
      ));
      allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- PUNISHMENT MODE ----------
    match /punishmentMode/{punishmentId} {
      // Admin can read all; child can only read their own
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      // Only admin can create punishment mode
      allow create: if signedIn() && isAdmin();

      // Only admin can deactivate punishment mode
      allow update: if signedIn() && isAdmin();

      // Only admin can delete punishment records
      allow delete: if signedIn() && isAdmin();
    }

    // ---------- PUNISHMENT TASK COMPLETIONS ----------
    match /punishmentTaskCompletions/{completionId} {
      // Admin can read all; child can only read their own
      // get: documento pode não existir ainda (resource == null); list: só os do próprio usuário
      allow get: if signedIn() && (isAdmin() || resource == null || resource.data.userId == request.auth.uid);
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);

      // Child can create their own completions; admin can also create
      allow create: if signedIn() && (
        isAdmin() || request.resource.data.userId == request.auth.uid
      );

      // Only admin can update or delete completions
      allow update, delete: if signedIn() && isAdmin();
    }
  }
}